@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}


<form asp-page-handler="update" method="post">
    <button class="btn btn-dark">Update</button>
</form>

<div class="text-center">
    <table class="table">
        @foreach (var d in Model.data)
        {
        <tr>
            <td>
                @d.ActivityDateTime.ToShortDateString()
            </td>
            <td>
                @d.Type
            </td>
            <td>
                @d.Distance.ToString("#0.00")
            </td>
            <td>
                @d.ElapsedTime
            </td>
            <td>
               <a href=@d.Link target="_blank">link</a>
            </td>
        </tr>
        }
    </table>

</div>
