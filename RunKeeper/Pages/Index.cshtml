@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center">
    <table>
        @foreach (var d in Model.data)
        {
        <tr>
            <td>
                @Html.DisplayFor(x => d.ActivityDateTime);
            </td>
            <td>
                @Html.DisplayFor(x => d.Type);
            </td>
            <td>
                @Html.DisplayFor(x => d.Distance);
            </td>
            <td>
                @Html.DisplayFor(x => d.ElapsedTime);
            </td>
            <td>
                @Html.DisplayFor(x => d.Link);
            </td>
        </tr>
        }
    </table>

</div>
